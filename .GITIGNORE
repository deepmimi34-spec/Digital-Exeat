```gitignore
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Test and coverage files
.coverage
htmlcov/
.pytest_cache/
.tox/

# Python packaging
build/
dist/
*.egg-info/

# IDE settings
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.bak
```